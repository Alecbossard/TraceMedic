# Real local inference, no account or metered service required.
TRACEMEDIC_PROVIDER=ollama
TRACEMEDIC_MODEL=tracemedic-qwen3:4b
TRACEMEDIC_MODEL_URL=http://127.0.0.1:11434
TRACEMEDIC_MODEL_TIMEOUT=90
TRACEMEDIC_TOOL_TIMEOUT=15
TRACEMEDIC_MAX_CALLS=18
TRACEMEDIC_MAX_TOOLS=14
TRACEMEDIC_MAX_STEPS=40
TRACEMEDIC_MAX_AGENT_TURNS=10
TRACEMEDIC_MAX_OUTPUT_TOKENS=1200
TRACEMEDIC_CONTEXT_TOKENS=8192
TRACEMEDIC_SEED=17
TRACEMEDIC_TEMPERATURE=0
# Optional existing OpenAI-compatible provider (base URL includes /v1).
# TRACEMEDIC_PROVIDER=openai-compatible
# TRACEMEDIC_MODEL_URL=http://localhost:1234/v1
# TRACEMEDIC_API_KEY=
